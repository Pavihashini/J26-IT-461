# Copy this file to backend/.env and fill in real values.
# If the database password contains special characters, percent-encode them in the URL.
# Example: @ -> %40, # -> %23, % -> %25

DATABASE_URL=postgresql://neondb_owner:[YOUR-PASSWORD]@ep-quiet-term-b5y9hpwu-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Object Storage bucket for uploaded images.
IMAGE_BUCKET_NAME=images
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.c-7.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Secret used to sign login tokens (32+ random characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
